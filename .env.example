# ============================================================
# RiskLens - environment configuration (copy to .env)
# ============================================================

# --- App ---
APP_NAME=RiskLens
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8010
# Base URL the web app uses to reach the API (browser -> API)
API_PUBLIC_URL=http://127.0.0.1:8010
# Secret used to sign JWTs. Change in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string-in-prod
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Root admin created by the seed script
SEED_ADMIN_EMAIL=admin@risklens.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://risklens:risklens@127.0.0.1:5432/risklens

# --- Redis (cache + job queue) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM chat provider ---
# provider: opencode | opencode-go | openai | anthropic | google | groq | lmstudio | ollama | vertex | custom
#
# Escolha (trocar = só .env, sem mudar código):
#   [Offline/demo]      LLM_PROVIDER=lmstudio  + LLM_MODEL=google/gemma-3-4b      (sem chave, confiável)
#   [Cloud grátis]      LLM_PROVIDER=opencode  + LLM_MODEL=mimo-v2.5-free          (OpenCode Zen; custo 0)
#   [Cloud pago/confiável] LLM_PROVIDER=opencode-go + LLM_MODEL=deepseek-v4-flash   (OpenCode Go; US$10/mês; sem rate-limit de rajada — bom p/ agentes/evals)
#   [Produção/GCP]      LLM_PROVIDER=vertex    + LLM_MODEL=gemini-2.0-flash-001    (Workload Identity)
#   [Produção/portátil] LLM_PROVIDER=openai    + LLM_MODEL=gpt-4o-mini
#   [Genérico]          LLM_PROVIDER=custom    + LLM_BASE_URL=...  (qualquer endpoint OpenAI-compatível)
#
# ⚠️ free tier do OpenCode Zen tem rate limit: extração e RAG (chamada única) OK;
#    fluxos multi-chamada (agente/evals) podem levar 429 → use opencode-go/lmstudio/vertex/openai.
LLM_PROVIDER=lmstudio
LLM_MODEL=google/gemma-3-4b
# Overrides usados por 'custom' (ou fallback de qualquer provider)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
# Temperatura e limite de tokens por chamada
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Credenciais por provider (só as que você usa precisam existir)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
# Base URL local do LM Studio (usado por provider=lmstudio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Google Vertex AI (enterprise/GCP) — usa google-genai; sem api_key usa ADC/Workload Identity
VERTEX_PROJECT=
VERTEX_REGION=us-central1
VERTEX_API_KEY=

# --- Embeddings (independentes do chat — o RAG pode usar um embedder diferente) ---
# provider: openai | lmstudio | ollama | fastembed | vertex | custom
# [Offline/demo]  EMBEDDING_PROVIDER=lmstudio  + EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# [Cloud grátis]  EMBEDDING_PROVIDER=fastembed + EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5  (ONNX, sem chave)
# [Produção]      EMBEDDING_PROVIDER=openai   + EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Dimensão fixa: todos os embedders suportados emitem 768 dims (pgvector vector(768))
EMBEDDING_DIMS=768
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio

# --- Observability ---
# Sem collector OTLP local (ex.: dentro do docker) → desligue p/ evitar retry spam em 127.0.0.1:4318
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=risklens-api

# --- Feature flags ---
FF_AGENT_REVIEW_ENABLED=true
FF_RAG_HYBRID_SEARCH=true
FF_EVAL_LLM_JUDGE=true

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=txt,md,pdf
# Path to sample documents + golden set used by evals (relative to apps/api cwd)
SAMPLES_DIR=../../samples
