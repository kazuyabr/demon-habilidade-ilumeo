# ============================================================
# RiskLens - environment configuration (copy to .env)
# ============================================================

# --- App ---
APP_NAME=RiskLens
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8010
# Base URL the web app uses to reach the API (browser -> API)
API_PUBLIC_URL=http://127.0.0.1:8010
# Secret used to sign JWTs. Change in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string-in-prod
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Root admin created by the seed script
SEED_ADMIN_EMAIL=admin@risklens.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://risklens:risklens@127.0.0.1:5432/risklens

# --- Redis (cache + job queue) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM provider ---
# provider: lmstudio | openai | anthropic | ollama
LLM_PROVIDER=lmstudio
# Base URL of the OpenAI-compatible endpoint (LM Studio local server)
LLM_BASE_URL=http://127.0.0.1:1234/v1
# API key (dummy for LM Studio; real key for OpenAI etc.)
LLM_API_KEY=lm-studio
# Generation model id as served by the provider
LLM_MODEL=google/gemma-3-4b
# Embedding model id (OpenAI-compatible /v1/embeddings)
LLM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# Embedding dimensions (nomic-embed-text v1.5 = 768)
LLM_EMBEDDING_DIMS=768
# Temperature for generation tasks
LLM_TEMPERATURE=0.1
# Max tokens per generation call
LLM_MAX_TOKENS=2048

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=risklens-api
OTEL_ENABLED=true

# --- Feature flags ---
FF_AGENT_REVIEW_ENABLED=true
FF_RAG_HYBRID_SEARCH=true
FF_EVAL_LLM_JUDGE=true

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=txt,md,pdf
# Path to sample documents + golden set used by evals (relative to apps/api cwd)
SAMPLES_DIR=../../samples
